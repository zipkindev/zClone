{
    "description": "Zclone volume plugin for Docker",
    "documentation": "//docker",
    "interface": {
        "socket": "zclone.sock",
        "types": ["docker.volumedriver/1.0"]
    },
    "linux": {
        "capabilities": [
            "CAP_SYS_ADMIN"
        ],
        "devices": [
            {
                "path": "/dev/fuse"
            }
        ]
    },
    "network": {
        "type": "host"
    },
    "entrypoint": ["zclone", "serve", "docker"],
    "workdir": "/data",
    "args": {
        "name": "args",
        "value": [],
        "settable": ["value"]
    },
    "env": [
        {
            "name": "ZCLONE_VERBOSE",
            "value": "0",
            "settable": ["value"]
        },
        {
            "name": "ZCLONE_CONFIG",
            "value": "/data/config/zclone.conf"
        },
        {
            "name": "ZCLONE_CACHE_DIR",
            "value": "/data/cache"
        },
        {
            "name": "ZCLONE_BASE_DIR",
            "value": "/mnt"
        },
        {
            "name": "HTTP_PROXY",
            "value": "",
            "settable": ["value"]
        },
        {
            "name": "HTTPS_PROXY",
            "value": "",
            "settable": ["value"]
        },
        {
            "name": "NO_PROXY",
            "value": "",
            "settable": ["value"]
        }
    ],
    "mounts": [
        {
            "name": "config",
            "source": "/var/lib/docker-plugins/zclone/config",
            "destination": "/data/config",
            "type": "bind",
            "options": ["rbind"],
            "settable": ["source"]
        },
        {
            "name": "cache",
            "source": "/var/lib/docker-plugins/zclone/cache",
            "destination": "/data/cache",
            "type": "bind",
            "options": ["rbind"],
            "settable": ["source"]
        }
    ],
    "propagatedMount": "/mnt"
}
